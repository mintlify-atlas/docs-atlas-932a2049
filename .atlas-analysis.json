  "keyFeatures": [
    "Zero-cost serialization/deserialization via Rust's trait system — no runtime reflection",
    "Derive macros (#[derive(Serialize, Deserialize)]) for automatic implementations",
    "Rich attribute system for renaming, skipping, flattening, tagging enums, and more",
    "Works with 20+ community data formats including JSON, YAML, TOML, MessagePack, CBOR, and more",
    "no_std support for embedded and constrained environments",
    "Support for zero-copy deserialization via borrowed data",
    "Customizable bounds, remote derives, and transparent wrappers"
  ],
  "publicApiSurface": [
    "trait Serialize",
    "trait Serializer",
    "trait Deserialize<'de>",
    "trait Deserializer<'de>",
    "mod ser (SerializeSeq, SerializeTuple, SerializeTupleStruct, SerializeTupleVariant, SerializeMap, SerializeStruct, SerializeStructVariant, Impossible)",
    "mod de (Visitor, SeqAccess, MapAccess, EnumAccess, VariantAccess, IgnoredAny, IntoDeserializer, de::value::*)",
    "#[derive(Serialize)] proc-macro",
    "#[derive(Deserialize)] proc-macro",
    "forward_to_deserialize_any! macro",
    "Attribute: serde(rename), serde(rename_all), serde(alias)",
    "Attribute: serde(skip), serde(skip_serializing), serde(skip_deserializing), serde(skip_serializing_if)",
    "Attribute: serde(default), serde(flatten), serde(transparent)",
    "Attribute: serde(tag), serde(content), serde(untagged)",
    "Attribute: serde(with), serde(serialize_with), serde(deserialize_with)",
    "Attribute: serde(bound), serde(remote), serde(from), serde(into), serde(try_from)",
    "Attribute: serde(deny_unknown_fields), serde(crate), serde(expecting)"
  ]
}
